[Unit]
Description=BridgewayTrades Django Backend (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/bridgewaytrades/backend/bridgewaytrades
EnvironmentFile=/var/www/bridgewaytrades/backend/bridgewaytrades/.env
ExecStart=/var/www/bridgewaytrades/backend/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8002 \
    --timeout 120 \
    --access-logfile /var/log/bridgewaytrades/gunicorn-access.log \
    --error-logfile /var/log/bridgewaytrades/gunicorn-error.log \
    bridgewaytrades.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
